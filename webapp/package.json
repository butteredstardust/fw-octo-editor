{
  "name": "fwinter-save-webapp",
  "version": "0.10.0",
  "description": "Forever Winter save editor webapp",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:unit": "node --test test/*.test.js test/e2e/*.test.js",
    "test:browser": "playwright test",
    "test:ci": "node --test test/*.test.js test/e2e/*.test.js && npm run lint && npm run test:coverage && playwright test",
    "coverage": "node --test --experimental-test-coverage test/*.test.js test/e2e/*.test.js",
    "test:coverage": "node scripts/coverage-gate.js",
    "lint": "eslint .",
    "key:build-resource": "node scripts/build-key-resource.js",
    "items:generate": "node scripts/generate-item-data.js",
    "items:fetch-wiki": "node scripts/fetch-wiki-items.js",
    "items:extract-reference": "node scripts/extract-reference-items.js",
    "items:audit": "node -e \"console.log(require('./data/item-map-audit.json').counts)\"",
    "recipes:fetch-wiki": "node scripts/fetch-wiki-recipes.js",
    "recipes:generate": "node scripts/generate-recipe-data.js",
    "recipes:audit": "node scripts/print-recipe-audit.js",
    "weapons:fetch-wiki": "node scripts/fetch-wiki-weapon-data.js",
    "weapons:generate": "node scripts/generate-weapon-build-data.js",
    "weapons:audit": "node -e \"console.log(require('./data/weapon-build-audit.json').counts)\""
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5"
  }
}
